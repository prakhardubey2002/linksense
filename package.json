{
  "name": "linksense",
  "private": true,
  "type": "module",
  "description": "URL platform detection and normalization toolkit",
  "author": "Prakhar Dubey <prakhardubey2002>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/prakhardubey2002/linksense.git"
  },
  "homepage": "https://github.com/prakhardubey2002/linksense#readme",
  "bugs": "https://github.com/prakhardubey2002/linksense/issues",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "validate:platforms": "node scripts/validate-platforms.js",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.39.4",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.7.0",
    "tsup": "^8.0.0",
    "turbo": "^2.9.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.59.4",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.15.0"
}
