{
  "name": "@linksense/angular",
  "version": "0.0.1",
  "description": "Angular service for linksense link/platform detection",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@linksense/core": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": ">=16.0.0"
  },
  "sideEffects": false,
  "license": "MIT"
}
