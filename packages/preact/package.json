{
  "name": "@linksense/preact",
  "version": "1.0.0",
  "description": "Preact hooks for URL platform detection — useLinksense, useDetectAll, useNormalizeUrl, useExtractFromUrl",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@linksense/core": "workspace:*"
  },
  "peerDependencies": {
    "preact": ">=10.0.0"
  },
  "sideEffects": false,
  "license": "MIT",
  "author": "Prakhar Dubey <prakhardubey2002>",
  "repository": {
    "type": "git",
    "url": "https://github.com/prakhardubey2002/linksense.git",
    "directory": "packages/preact"
  },
  "homepage": "https://github.com/prakhardubey2002/linksense/tree/main/packages/preact#readme",
  "bugs": "https://github.com/prakhardubey2002/linksense/issues",
  "keywords": [
    "preact",
    "hooks",
    "url",
    "link",
    "platform",
    "detection",
    "social-media",
    "linksense"
  ],
  "engines": {
    "node": ">=18"
  }
}
